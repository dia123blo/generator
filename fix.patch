+def run_analog_generation(args):
+    os.makedirs(args.analog_save_dir, exist_ok=True)
+    forced_template = None
+    if args.template:
+        forced_template = next(t for t in TEMPLATES if t["name"] == args.template)
+
+    gen = AnalogCircuitGenerator(
+        tech_name=args.tech,
+        min_devices=args.min_devices,
+        max_devices=args.max_devices,
+        seed=args.seed,
+    )
+
+    for i in range(args.num_graphs):
+        cg = gen.generate(target_devices=args.target_devices, template=forced_template)
+        ok, violations = gen.validate(cg)
+        out_path = os.path.join(
+            args.analog_save_dir,
+            "circuit_%s_N%d_%d.gml" % (args.tech, cg.num_devices(), i))
+        save_circuit_graph(cg, out_path)
+        print("[%d] devices=%d  nets=%d  edges=%d  valid=%s  path=%s"
+              % (i, cg.num_devices(), cg.num_nets(), cg.g.ecount(), ok, out_path))
+        if not ok:
+            print("    violations:", violations)
+
+
+def _load_or_generate_patterns(args, save_pattern_dir):
+    if args.pattern_source == "existing":
+        src_dir = args.pattern_dir or CONFIG.get("existing_pattern_dir")
+        if not src_dir or not os.path.exists(src_dir):
+            raise ValueError("pattern_source=existing requires a valid --pattern_dir (or CONFIG existing_pattern_dir).")
+        patterns = load_existing_patterns(src_dir)
+        for p in patterns:
+            if os.path.exists(p["path"]):
+                shutil.copy2(p["path"], os.path.join(save_pattern_dir, p["file"]))
+        return patterns
+
+    # generate模式：复用原有pattern生成逻辑
+    for number_of_pattern_vertices in CONFIG["number_of_pattern_vertices"]:
+        for number_of_pattern_vertex_labels in CONFIG["number_of_pattern_vertex_labels"]:
+            if number_of_pattern_vertex_labels > number_of_pattern_vertices:
+                continue
+            for number_of_pattern_edges in CONFIG["number_of_pattern_edges"]:
+                if number_of_pattern_edges < number_of_pattern_vertices - 1:
+                    continue
+                if number_of_pattern_edges > CONFIG["max_ratio_of_edges_vertices"] * number_of_pattern_vertices:
+                    continue
+                for number_of_pattern_edge_labels in CONFIG["number_of_pattern_edge_labels"]:
+                    if number_of_pattern_edge_labels > number_of_pattern_edges:
+                        continue
+                    patterns_id = "P_N%d_E%d_NL%d_EL%d" % (
+                        number_of_pattern_vertices, number_of_pattern_edges,
+                        number_of_pattern_vertex_labels, number_of_pattern_edge_labels)
+                    for p, pattern in enumerate(generate_patterns(
+                        number_of_pattern_vertices, number_of_pattern_edges,
+                        number_of_pattern_vertex_labels, number_of_pattern_edge_labels,
+                        CONFIG["number_of_patterns"])):
+                        pattern.vs["label"] = [str(x) for x in pattern.vs["label"]]
+                        pattern.es["label"] = [str(x) for x in pattern.es["label"]]
+                        if "key" in pattern.es.attributes():
+                            pattern.es["key"] = [str(x) for x in pattern.es["key"]]
+                        pattern.write(os.path.join(save_pattern_dir, patterns_id + "_%d.gml" % p))
+    return load_existing_patterns(save_pattern_dir)
+
+
+def run_analog_pattern_dataset(args):
+    np.random.seed(args.seed)
+    dataset_root = args.dataset_save_dir
+    save_pattern_dir = os.path.join(dataset_root, "patterns")
+    save_graph_dir = os.path.join(dataset_root, "graphs")
+    save_metadata_dir = os.path.join(dataset_root, "metadata")
+    os.makedirs(save_pattern_dir, exist_ok=True)
+    os.makedirs(save_graph_dir, exist_ok=True)
+    os.makedirs(save_metadata_dir, exist_ok=True)
+
+    patterns = _load_or_generate_patterns(args, save_pattern_dir)
+    checker = PatternChecker()
+    gen = AnalogCircuitGenerator(
+        tech_name=args.tech,
+        min_devices=args.min_devices,
+        max_devices=args.max_devices,
+        seed=args.seed,
+    )
+
+    summary = {"total_graphs": 0, "valid_graphs": 0, "patterns": []}
+    for pidx, pinfo in enumerate(patterns):
+        pattern = pinfo["pattern"]
+        pattern_name = os.path.splitext(pinfo["file"])[0]
+        p_graph_dir = os.path.join(save_graph_dir, pattern_name)
+        p_meta_dir = os.path.join(save_metadata_dir, pattern_name)
+        os.makedirs(p_graph_dir, exist_ok=True)
+        os.makedirs(p_meta_dir, exist_ok=True)
+        p_stats = {"pattern": pattern_name, "generated": 0, "valid": 0, "positive": 0, "sum_count": 0}
+
+        for i in range(args.num_samples_per_pattern):
+            cg = None
+            ok = False
+            violations = []
+            for _ in range(args.max_resample):
+                cg = gen.generate(target_devices=args.target_devices)
+                ok, violations = gen.validate(cg)
+                if ok:
+                    break
+            if cg is None:
+                continue
+            g = circuit_graph_to_igraph(cg)
+            # 为了与pattern checker兼容，提供简单label映射
+            g.vs["label"] = [str(v["node_type"]) for v in g.vs]
+            g.es["label"] = [str(e["port_type"]) for e in g.es]
+            subisomorphisms = checker.get_subisomorphisms(g, pattern)
+            count = len(subisomorphisms)
+            exists = count > 0
+
+            meta = {
+                "graph_id": f"{pattern_name}_{i}",
+                "pattern_name": pattern_name,
+                "pattern_source": args.pattern_source,
+                "label_mode": args.label_mode,
+                "count": count,
+                "exists": exists,
+                "subisomorphisms": subisomorphisms,
+                "physics_valid": ok,
+                "violations": violations,
+                "tech": args.tech,
+                "device_count": cg.num_devices(),
+                "net_count": cg.num_nets(),
+                "edge_count": cg.g.ecount(),
+            }
+
+            graph_path = os.path.join(p_graph_dir, f"{pattern_name}_{i}.gml")
+            meta_path = os.path.join(p_meta_dir, f"{pattern_name}_{i}.meta.json")
+            save_circuit_graph(cg, graph_path)
+            with open(meta_path, "w", encoding="utf-8") as f:
+                json.dump(meta, f, ensure_ascii=False)
+
+            p_stats["generated"] += 1
+            p_stats["valid"] += int(ok)
+            p_stats["positive"] += int(exists)
+            p_stats["sum_count"] += count
+            summary["total_graphs"] += 1
+            summary["valid_graphs"] += int(ok)
+
+        summary["patterns"].append(p_stats)
+
+    with open(os.path.join(dataset_root, "summary.json"), "w", encoding="utf-8") as f:
+        json.dump(summary, f, ensure_ascii=False, indent=2)
